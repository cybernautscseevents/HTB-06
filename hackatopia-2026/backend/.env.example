# LLM: one string picks the provider and model (NFR-7). Without a usable key everything
# still runs on deterministic fallbacks.
#   google_genai:gemini-3.5-flash    Gemini           needs GOOGLE_API_KEY (or GEMINI_API_KEY)
#   ollama:llama3.1                  local Ollama     needs `ollama serve` and the model pulled
#   ollama:gpt-oss:120b              Ollama Cloud     needs OLLAMA_API_KEY
#   anthropic:claude-haiku-5-5       Anthropic        needs ANTHROPIC_API_KEY
LLM_MODEL=google_genai:gemini-3.5-flash
GOOGLE_API_KEY=
# Ollama: leave both empty for a local server on http://localhost:11434.
# For Ollama Cloud set the key; the URL then defaults to https://ollama.com.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub OAuth App: lets users sign in and open the PR as themselves.
# Create one at https://github.com/settings/developers with
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# public_repo: open PRs on public repos. repo: also audit private repos and private git dependencies.
GITHUB_OAUTH_SCOPE=public_repo

# Optional fallback when nobody is signed in: a token scoped to the demo repo (NFR-4). Never commit.
GITHUB_TOKEN=

# Behaviour
USE_STUBS=false
OFFLINE=false
MAX_FANOUT=30
MAX_FINDINGS=250
MAX_CODE_FIXES=8
MAX_VERIFIER_RETRIES=2
CORS_ORIGIN=http://localhost:5173

# Demo hook for AC-3: first remediation attempt uses this (still vulnerable) version,
# so the verifier rejects it and the critic loop recovers. Example: pyyaml==5.3.1
FORCE_BAD_VERSION=

# Optional: where clones and venvs live (default: system temp dir)
WORK_DIR=

# Optional: full path to syft if it is not on PATH (or drop syft.exe into backend/bin/)
SYFT_BIN=

# Storage: Neon / PostgreSQL. Use the pooled connection string from the Neon console.
# Empty = a local SQLite file at backend/data/app.db.
DATABASE_URL=
# Encrypts stored sign-in sessions. Empty = derived from GITHUB_CLIENT_SECRET.
SESSION_SECRET=

# LangSmith tracing: every agent, tool and LLM call of each audit. Empty = off.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=threat-pilot

# Cloned repositories and their virtualenvs are deleted this many days after their last audit.
WORKSPACE_TTL_DAYS=30
LOG_LEVEL=INFO

# Use an SBOM already committed in the audited repository instead of generating one.
USE_EXISTING_SBOM=true
